# Copy to .env and fill in real values. Never commit .env.

# --- Server ---
PORT=3000
# NODE_ENV=development

# --- Rate limiting (all routes under /api; /health is not limited) ---
# Window length in ms (default 900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
# Max requests per client IP per window (default 100)
RATE_LIMIT_MAX=100
# When behind a reverse proxy, trust X-Forwarded-For for client IP (required for accurate /api limits).
# Use 1, true, yes for a single proxy hop, or a positive integer for hop count.
# TRUST_PROXY=1

# --- Database (required) ---
# Local MongoDB
MONGO_URI=mongodb://localhost:27017/arn_db
#
# MongoDB Atlas (example)
# 1) Create cluster + DB user
# 2) Atlas Network Access: allow your current public IP
# 3) Paste the URI from Atlas "Connect → Drivers"
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/<dbName>?retryWrites=true&w=majority&appName=<appName>

# --- OpenAI (required for LLM calls; no in-code defaults for model / temperature / max tokens) ---
OPENAI_API_KEY=sk-your-openai-api-key
# Chat RAG path: synthesis over retrieved BRS chunks + no-index chat fallback (same model).
OPENAI_MODEL=gpt-4o
# Optional: fast/cheap model for portal chat greeting/small-talk only (direct path). If omitted, uses OPENAI_MODEL.
OPENAI_CHAT_DIRECT_MODEL=gpt-4.1-mini
# Role-based models (agent routing)
# Fetch: GPT‑4o
OPENAI_FETCH_MODEL=gpt-4o
# Dev: GPT‑5 (Codex) or GPT‑4.1
OPENAI_DEV_MODEL=gpt-4.1
# PM: GPT‑4.1
OPENAI_PM_MODEL=gpt-4.1
OPENAI_TEMPERATURE=0
OPENAI_MAX_TOKENS=8000
# BRS Reviewer agent — use a reasoning-class model (see RULE-REVIEW-004)
OPENAI_BRS_REVIEWER_MODEL=o4-mini

# --- BRS pipeline tuning ---
# Inputs at or below this token estimate use the "small" path (default 4000)
BRS_SMALL_INPUT_TOKEN_THRESHOLD=4000

# RecursiveCharacterTextSplitter (character-based chunkSize / chunkOverlap)
CHUNK_SIZE=1500
CHUNK_OVERLAP=200

# --- OpenAI embeddings (required for BRS indexing + chat RAG) ---
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
# Optional: reduced dimensions for text-embedding-3 (omit for full width, e.g. 3072 for -large)
# OPENAI_EMBEDDING_DIMENSIONS=1024

# --- Qdrant (required for vector RAG) ---
# Local: docker run -p 6333:6333 qdrant/qdrant
QDRANT_URL=http://127.0.0.1:6333
# QDRANT_API_KEY=   # Qdrant Cloud or secured instances
QDRANT_COLLECTION_NAME=arn_brs
# Separate collection for merge-report vectors (linked to BRS via shared runId in payload).
QDRANT_MERGE_COLLECTION_NAME=arn_brs_merge

# --- Langfuse (optional; tracing works when keys are set) ---
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
